# Copy to .env for the Node static server. Defaults use public Solana RPCs.
PORT=3000
HOST=0.0.0.0
RPC_DEVNET=https://api.devnet.solana.com
RPC_MAINNET=https://api.mainnet-beta.solana.com

# Optional Jupiter key. It is injected into browser config and is visible to visitors.
# Use a browser-origin-restricted key; leave blank for the free lite API.
JUPITER_API_KEY=
